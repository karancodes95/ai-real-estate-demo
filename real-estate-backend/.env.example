# Copy to .env and fill in. See README for setup.
# Keys match the fields in app/config.py (pydantic-settings, case-insensitive).

# Async SQLAlchemy URL for the local Postgres leads DB (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://demo_app@localhost:5432/lead_to_lease

# Static demo API key gating the JSON API (chat + CRM data). The static Pages
# frontends send it in X-API-Key. Low-value bot-gate (ships in the client), not
# a real secret, but must be non-empty. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=replace-with-a-long-random-string

# Comma-separated CORS origins for production (the deployed frontend origin(s),
# e.g. https://karancodes95.github.io). Empty = "*" (fine for local dev).
ALLOWED_ORIGINS=

# Demo agency branding (fictional; this is not a real agency).
AGENCY_NAME=Amberstone Realty
AGENCY_EMAIL=hello@example.com

# Day-0 confirmation email via SMTP over SSL (stdlib smtplib, app-password auth).
# Leave ZOHO_EMAIL empty to skip sending; local dev works end-to-end minus the
# actual email. Use an app-specific password, never your account password.
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# Abuse guard: max chat messages per client IP per day (0 = unlimited).
CHAT_DAILY_IP_CAP=10

# Only trust X-Forwarded-For when behind a proxy that sets it; otherwise a
# client could spoof the header to dodge the cap. Set true in prod (VPS/proxy).
TRUST_PROXY=false

# LLM: Claude via the Claude Agent SDK. No API key here; the SDK uses your
# local Claude Code login for dev, or CLAUDE_CODE_OAUTH_TOKEN on a server.
